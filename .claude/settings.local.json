{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(taskkill /F /FI \"WINDOWTITLE eq npm*\" /T)",
      "Bash(taskkill /F /FI \"COMMANDLINE eq *next dev*\" /T)",
      "Bash(Remove-Item -Recurse -Force .next -ErrorAction SilentlyContinue)",
      "Bash(git init *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git remote *)",
      "Bash(git push *)"
    ]
  }
}
