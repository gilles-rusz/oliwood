# ─── BASE DE DONNÉES ───────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ─── SUPABASE ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://VOTRE_PROJET.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="votre_anon_key"
SUPABASE_SERVICE_ROLE_KEY="votre_service_role_key"

# ─── AUTH (NextAuth) ───────────────────────────────────────────
# Obligatoire, y compris en local : openssl rand -base64 32
# S'il change (ou s'il est absent), toutes les sessions admin sont invalidées.
NEXTAUTH_SECRET="generer_avec_openssl_rand_base64_32"
# Doit correspondre exactement au port utilisé par `npm run dev`
NEXTAUTH_URL="http://localhost:3000"

# ─── ADMIN ─────────────────────────────────────────────────────
# Le compte admin est stocké en base (table Admin), pas dans ce fichier.
# Création / changement de mot de passe : npm run admin:create
# Diagnostic de connexion :               npm run admin:check

# ─── EMAIL (Nodemailer) ────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="votre@gmail.com"
SMTP_PASS="votre_app_password"
EMAIL_FROM="OliWood <contact@oliwood.fr>"
EMAIL_TO="contact@oliwood.fr"

# ─── RECAPTCHA v3 ──────────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="votre_site_key"
RECAPTCHA_SECRET_KEY="votre_secret_key"

# ─── META / FACEBOOK (galerie auto) ───────────────────────────
META_APP_ID="votre_app_id"
META_APP_SECRET="votre_app_secret"
META_PAGE_ACCESS_TOKEN="votre_page_access_token"
META_WEBHOOK_VERIFY_TOKEN="token_secret_de_votre_choix"

# ─── SÉCURITÉ RATE LIMITING ────────────────────────────────────
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="10"
