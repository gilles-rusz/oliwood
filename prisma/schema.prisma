// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── ADMIN ─────────────────────────────────────────────────────
model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // bcrypt hash
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── RÉALISATIONS (galerie) ────────────────────────────────────
model Realisation {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    Category @default(AUTRE)
  imageUrl    String
  thumbUrl    String?
  source      Source   @default(MANUAL)   // MANUAL | FACEBOOK | INSTAGRAM
  externalId  String?  @unique            // ID Facebook/Instagram si sync auto
  published   Boolean  @default(true)
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Category {
  CHARPENTE
  TERRASSE
  PERGOLA
  CABANE
  RENOVATION
  AUTRE
}

enum Source {
  MANUAL
  FACEBOOK
  INSTAGRAM
}

// ── DEVIS ─────────────────────────────────────────────────────
model Devis {
  id          String      @id @default(cuid())
  // Contact
  nom         String
  prenom      String
  email       String
  telephone   String?
  // Projet
  typeProjet  TypeProjet
  description String?
  budget      Budget?
  delai       String?
  // Localisation
  ville       String?
  codePostal  String?
  // Statut
  statut      StatutDevis @default(NOUVEAU)
  notes       String?     // notes admin
  // Sécurité
  honeypot    String?     // doit être vide
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum TypeProjet {
  CHARPENTE
  TERRASSE
  PERGOLA
  CABANE
  RENOVATION
  AUTRE
}

enum Budget {
  MOINS_5K
  ENTRE_5K_15K
  ENTRE_15K_30K
  ENTRE_30K_50K
  PLUS_50K
  A_DEFINIR
}

enum StatutDevis {
  NOUVEAU
  VU
  EN_COURS
  ENVOYE
  ACCEPTE
  REFUSE
  ARCHIVE
}

// ── PARAMÈTRES SITE ───────────────────────────────────────────
model SiteSettings {
  id              String   @id @default("singleton")
  // Décorations saisonnières
  seasonalTheme   String?  // "NOEL" | "PRINTEMPS" | null
  seasonalActive  Boolean  @default(false)
  // Contenu
  heroTitle       String?
  heroSubtitle    String?
  metaDescription String?
  // Contact
  telephone       String?
  email           String?
  adresse         String?
  updatedAt       DateTime @updatedAt
}
